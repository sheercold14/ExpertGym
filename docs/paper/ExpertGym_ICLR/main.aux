\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Residual diagnostics motivate behavior-constrained composition.} Left: code evidence is source/span-conditioned; LiveBench prompt evidence and LiveCodeBench prompt evidence are nearly opposite directions. Middle: most of the $588$ residual rows are conflict, weak-evidence, behavior-supporting, or noise-like rows rather than clean task rows. Right: mechanism variants expose a Memory--Code trade-off; scalar code shrinkage improves memory but damages code, while soft behavior constraints keep a continuous code field.}}{4}{figure.1}\protected@file@percent }
\newlabel{fig:diagnostic-residual-field}{{1}{4}{\textbf {Residual diagnostics motivate behavior-constrained composition.} Left: code evidence is source/span-conditioned; LiveBench prompt evidence and LiveCodeBench prompt evidence are nearly opposite directions. Middle: most of the $588$ residual rows are conflict, weak-evidence, behavior-supporting, or noise-like rows rather than clean task rows. Right: mechanism variants expose a Memory--Code trade-off; scalar code shrinkage improves memory but damages code, while soft behavior constraints keep a continuous code field}{figure.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Pairwise-zero diagnostics show why expert-level deletion is not a method.} Left: pairwise opposite-sign rates are task-span specific; unavailable behavior probes are shown as N/A rather than as zero conflict. Middle: zeroing one expert removes mixed residual roles, including code-repair, behavior-support, shared-positive, and source-conflict rows. Right: the existing \textsc  {Code}\xspace  $=0$ ablation increases memory but damages code, making scalar zeroing a negative control rather than a composition rule.}}{4}{figure.2}\protected@file@percent }
\newlabel{fig:pairwise-zero}{{2}{4}{\textbf {Pairwise-zero diagnostics show why expert-level deletion is not a method.} Left: pairwise opposite-sign rates are task-span specific; unavailable behavior probes are shown as N/A rather than as zero conflict. Middle: zeroing one expert removes mixed residual roles, including code-repair, behavior-support, shared-positive, and source-conflict rows. Right: the existing \code $=0$ ablation increases memory but damages code, making scalar zeroing a negative control rather than a composition rule}{figure.2}{}}
